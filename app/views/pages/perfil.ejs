<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meu Perfil — EcoGeneration</title>
  <meta name="description" content="Gerencie seu perfil, veja diagnósticos e histórico de compras.">
  <meta name="robots" content="noindex, follow">
  <meta name="description" content="Gerencie seu perfil, veja histórico de diagnósticos e compras na EcoGeneration.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/perfil.css">
  <link rel="icon" href="/imagens/favicon2.png" type="image/png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.css">

  <!-- Open Graph (OG) — cartão de visitas nas redes sociais -->
  <meta property="og:locale" content="pt_BR">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Meu Perfil — EcoGeneration">
  <meta property="og:description" content="Gerencie seu perfil, veja seu histórico de diagnósticos e compras.">
  <meta property="og:url" content="https://ecogeneration-final-4hh3.onrender.com">
  <meta property="og:site_name" content="EcoGeneration">
  <meta property="og:image" content="https://ecogeneration-final-4hh3.onrender.com/imagens/og-cover-v2.png">
  <meta property="og:image:secure_url" content="https://ecogeneration-final-4hh3.onrender.com/imagens/og-cover-v2.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="EcoGeneration — Autonomia Energética">
  <!-- Twitter/X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Meu Perfil — EcoGeneration">
  <meta name="twitter:description" content="Gerencie seu perfil, veja seu histórico de diagnósticos e compras.">
  <meta name="twitter:image" content="https://ecogeneration-final-4hh3.onrender.com/imagens/og-cover-v2.png">
  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2e7d32">
</head>
<body>
  <a href="#conteudo-principal" class="skip-link">Ir para o conteúdo principal</a>

  <%- include('../partials/header') %>

  <main id="conteudo-principal" class="perfil-container">

    <header class="perfil-header">
      <figure class="perfil-avatar">
          <% if (usuario.imagem_perfil_usuario) { %>
            <img src="/<%= usuario.imagem_perfil_usuario %>" alt="Foto de perfil de <%= usuario.nome_usuario %>">
          <% } else { %>
            <img src="/imagens/favicon2.png" alt="Imagem padrão de perfil">
          <% } %>
      </figure>
      <section class="perfil-info" aria-label="Dados do usuário">
        <h1><%= usuario.nome_usuario %></h1>
        <p><%= usuario.email_usuario %></p>
      </section>
    </header>

      <section class="perfil-secao">
        <h2>Dados do perfil</h2>
        <form action="/perfil" method="POST" enctype="multipart/form-data" class="perfil-form">
          <label for="nome">Nome</label>
          <input id="nome" name="nome" type="text" value="<%= usuario.nome_usuario %>" required maxlength="100">
          <label for="telefone">Telefone</label>
          <input id="telefone" name="telefone" type="tel" value="<%= usuario.telefone_usuario || '' %>" placeholder="(11) 99999-9999">
          <label for="cep">CEP</label>
          <input id="cep" name="cep" type="text" value="<%= usuario.cep_usuario || '' %>" placeholder="00000-000" maxlength="9">
          <% if (endereco) { %>
            <p class="endereco-via-cep"><%= endereco.logradouro %>, <%= endereco.bairro %> - <%= endereco.localidade %>/<%= endereco.uf %></p>
          <% } else if (erroCep) { %>
            <p class="campo-dica">Não foi possível consultar o endereço agora.</p>
          <% } else if (usuario.cep_usuario) { %>
            <p class="campo-dica">CEP não encontrado.</p>
          <% } %>
          <label for="numero">Número</label>
          <input id="numero" name="numero" type="text" value="<%= usuario.numero_usuario || '' %>" maxlength="10">
          <label for="complemento">Complemento</label>
          <input id="complemento" name="complemento" type="text" value="<%= usuario.complemento_usuario || '' %>" maxlength="100">
          <label for="imagem">Imagem de perfil</label>
          <input id="imagem" name="imagem" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
          <img id="preview-imagem" class="perfil-preview" src="<%= usuario.imagem_perfil_usuario ? '/' + usuario.imagem_perfil_usuario : '/imagens/favicon2.png' %>" alt="Prévia da imagem de perfil">
          <label for="senha_atual">Senha atual</label>
          <input id="senha_atual" name="senha_atual" type="password" minlength="6" maxlength="72" autocomplete="current-password" placeholder="Digite sua senha atual">
          <label for="senha">Nova senha</label>
          <input id="senha" name="senha" type="password" minlength="6" maxlength="72" autocomplete="new-password" placeholder="Digite a nova senha">
          <label for="confirmarSenha">Confirmar nova senha</label>
          <input id="confirmarSenha" name="confirmarSenha" type="password" minlength="6" maxlength="72" autocomplete="new-password" placeholder="Confirme a nova senha">
          <p class="campo-dica">Preencha apenas se quiser alterar a senha.</p>
          <button type="submit" class="btn-acao">Salvar alterações</button>
        </form>
      </section>

    <!-- COMPRAS -->
    <section class="perfil-secao">
      <h2>Minhas Compras</h2>
      <% if (compras && compras.length > 0) { %>
        <ul class="compras-lista">
          <% compras.forEach(function(compra) { %>
            <li class="compra-item">
              <figure class="compra-item-img">
                <img src="/imagens/<%= compra.imagem_produto %>" alt="<%= compra.nome_produto %>">
              </figure>
              <section class="compra-item-info" aria-label="Detalhes da compra">
                <h3><%= compra.nome_produto %></h3>
                <p class="compra-item-preco">R$ <%= compra.preco_produto %></p>
                <p class="compra-item-status">
                  <span class="badge-confirmado"><%= compra.status_compra %></span>
                </p>
              </section>
              <aside class="compra-item-id" aria-label="Número do pedido">
                <p>Pedido #<%= compra.id_compra %></p>
              </aside>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="sem-itens">Você ainda não realizou nenhuma compra.</p>
        <a href="/ecoloja" class="btn-acao">Ir para a loja</a>
      <% } %>
    </section>

    <!-- DIAGNÓSTICOS -->
    <section class="perfil-secao">
      <h2>Meus Diagnósticos</h2>
      <% if (diagnosticos && diagnosticos.length > 0) { %>
        <ul class="diagnosticos-lista">
          <% diagnosticos.forEach(function(diag) { %>
            <li class="diagnostico-item">
              <header class="diagnostico-nivel <%= diag.nivel_autonomia %>">
                <strong>Autonomia <%= diag.nivel_autonomia %></strong>
              </header>
              <section class="diagnostico-detalhes" aria-label="Detalhes do diagnóstico">
                <p><strong>Frequência:</strong> <%= diag.frequencia %></p>
                <p><strong>Impacto:</strong> <%= diag.impacto %></p>
                <p><strong>Preparação:</strong> <%= diag.preparacao %></p>
                <p><strong>Prioridade:</strong> <%= diag.prioridade %></p>
                <p><strong>Tolerância:</strong> <%= diag.tolerancia %></p>
              </section>
              <footer class="diagnostico-acoes">
                <a href="/diagnostico" class="btn-refazer">Refazer diagnóstico</a>
              </footer>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="sem-itens">Você ainda não fez nenhum diagnóstico.</p>
        <a href="/diagnostico" class="btn-acao">Fazer diagnóstico agora</a>
      <% } %>
    </section>

    <!-- ZONA DE PERIGO -->
    <section class="perfil-secao perfil-perigo">
      <h2>Zona de Perigo</h2>
      <p>Ao excluir sua conta, todos os seus dados serão removidos permanentemente.</p>
      <button class="btn-excluir" id="btn-excluir-conta">Excluir minha conta</button>

      <dialog class="modal-confirmacao" id="modal-excluir" aria-hidden="true">
        <article class="modal-box">
          <h3>Tem certeza?</h3>
          <p>Esta ação não pode ser desfeita. Todos os seus dados serão excluídos.</p>
          <footer class="modal-acoes">
            <form action="/excluir-conta" method="POST">
              <button type="submit" class="btn-confirmar-excluir">Sim, excluir minha conta</button>
            </form>
            <button class="btn-cancelar" id="btn-cancelar-excluir">Cancelar</button>
          </footer>
        </article>
      </dialog>
    </section>

  </main>

  <%- include('../partials/footer') %>
  <!-- simple-notify JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.min.js"></script>
  <!-- Função centralizada de notificações -->
  <script src="/js/notify.js"></script>
  <!-- Flash Message -->
  <%- include('../partials/flash') %>
  <script src="/js/perfil.js"></script>
  <script>
    const imagemInput = document.getElementById('imagem');
    const previewImagem = document.getElementById('preview-imagem');
    if (imagemInput && previewImagem) imagemInput.addEventListener('change', () => {
      const arquivo = imagemInput.files[0];
      if (arquivo) previewImagem.src = URL.createObjectURL(arquivo);
    });
  </script>
</body>
</html>
